%% ==========================================
%% Architecture & Telephony Pipeline Diagram
%% ==========================================

graph TD
    classDef telephony fill:#f9f,stroke:#333,stroke-width:2px;
    classDef gateway fill:#bbf,stroke:#333,stroke-width:2px;
    classDef brain fill:#dfd,stroke:#333,stroke-width:2px;
    classDef server fill:#fdd,stroke:#333,stroke-width:2px;
    
    Customer[Customer Phone / PSTN] <-->|SIP Trunk / WebRTC| Vapi[Vapi.ai Voice Gateway]
    
    subgraph Vapi.ai Pipeline [Turn-taking Latency Budget: ~650ms / Limit: 1.2s]
        STT[Deepgram Nova-2 STT <br> Latency: ~120ms]
        Orchestration[GPT-4o-mini LLM <br> Latency: ~280ms]
        TTS[Cartesia TTS <br> Latency: ~100ms]
    end
    
    Vapi <-->|Audio Stream| STT
    STT -->|Text Transcript| Orchestration
    Orchestration -->|Text Output Stream| TTS
    TTS <-->|Audio Stream| Vapi
    
    Orchestration <-->|Tool Call JSON| Webhook[FastAPI Webhook Server <br> Latency: ~80ms]
    
    subgraph Mock Backend Layer
        Database[(Kapture CRM database)]
        SMS[SMS Gateway / Twilio]
    end
    
    Webhook <-->|Read / Write| Database
    Webhook -->|Trigger SMS Link| SMS

    class Customer telephony;
    class Vapi gateway;
    class STT,Orchestration,TTS brain;
    class Webhook,Database,SMS server;


%% ==========================================
%% Enforced Authentication State Machine
%% ==========================================

stateDiagram-v2
    classDef state_locked fill:#fdd,stroke:#333,stroke-width:1px;
    classDef state_unlocked fill:#dfd,stroke:#333,stroke-width:1px;
    
    [*] --> STATE_0_GREETING_AND_DISCLOSURE
    
    STATE_0_GREETING_AND_DISCLOSURE --> STATE_1_VERIFYING : Customer answers speaking
    STATE_0_GREETING_AND_DISCLOSURE --> STATE_5_CLOSURE : Denies / Wrong Person
    
    state "STATE_1_VERIFYING (Compliance Auth Gate)" as STATE_1_VERIFYING
    note right of STATE_1_VERIFYING
        Locks debt disclosure.
        Requires 4 digits Aadhaar.
        If incorrect 2 times, terminate call.
    end note
    
    STATE_1_VERIFYING --> STATE_2_DEBT_DISCLOSURE : Aadhaar verification successful (Mock match '1234')
    STATE_1_VERIFYING --> STATE_1_VERIFYING : Fails (Attempt 1)
    STATE_1_VERIFYING --> STATE_5_CLOSURE : Fails twice / Refuses
    
    state "STATE_2_DEBT_DISCLOSURE (Debt Disclosed)" as STATE_2_DEBT_DISCLOSURE
    note right of STATE_2_DEBT_DISCLOSURE
        Unlocks debt details disclosure.
        Reads Mini-Miranda.
    end note
    
    STATE_2_DEBT_DISCLOSURE --> STATE_3_NEGOTIATION : Transition immediately
    
    STATE_3_NEGOTIATION --> STATE_4_ACTION : Agree to pay today / Promise within 3 days
    STATE_3_NEGOTIATION --> STATE_5_CLOSURE : Dispute / Already Paid / Financial Hardship
    
    STATE_4_ACTION --> STATE_5_CLOSURE : SMS Payment Link Sent / PTP Date Logged in CRM
    
    STATE_5_CLOSURE --> [*] : Mark disposition & terminate call
